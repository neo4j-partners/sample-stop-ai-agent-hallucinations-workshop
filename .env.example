# Environment variables for the workshop labs.
#
# Copy this file to `.env` (in the repo root, or in a specific lab folder
# such as 01-graph-build/) and fill in real values. A lab-local `.env` takes
# precedence over the root one. The `.env` file is gitignored and must never
# be committed.
#
# AT A HOSTED WORKSHOP: the CloudFormation environment generates
# `/workshop/.env` with the instance already filled in. Do not overwrite that
# file with this template. `00-setup/verify_setup.py` prints which file
# supplied the values it used.
#
# NOTE ON THE USERNAME VARIABLE: every lab in THIS repository reads
# NEO4J_USERNAME. The generated hosted file uses NEO4J_USER instead. If you are
# running inside the hosted workshop and a lab cannot authenticate, that
# mismatch is the first thing to check: add NEO4J_USERNAME with the same value.

# --- Neo4j (every lab) ---
# Neo4j Aura is the supported path: paste the neo4j+s:// URI from your AuraDB
# instance. A local Docker instance would be bolt://localhost:7687 instead.
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
# Optional. Aura's default database is `neo4j`, which is also what
# workshop.contracts.DEFAULT_NEO4J_DATABASE falls back to when this is unset.
NEO4J_DATABASE=neo4j

# --- Lab 5 AgentCore deploy ---
# You do NOT set these by hand. The first three are written by
# setup/provision_agentcore.py after it creates the infrastructure, and
# 5.1_agentcore_deploy.ipynb reads them. AGENT_RUNTIME_ARN is written by 5.1
# itself once the Runtime launches, and 5.2 and 5.3 read it from here.
# The deployed Runtime reads Neo4j from the NEO4J_* values above; there is no
# separate read secret.
# AGENTCORE_GATEWAY_URL=<gateway-mcp-url>
# AGENTCORE_RUNTIME_ROLE_ARN=<runtime-execution-role-arn>
# NEO4J_COMMAND_SECRET_ID=<reservation-command-secret-id>
# AGENT_RUNTIME_ARN=<deployed-runtime-arn>

# --- AWS / Amazon Bedrock (all labs) ---
# AWS_REGION is the one the labs read. AWS_DEFAULT_REGION is the botocore-wide
# name, and the deployed Runtime falls back to it when AWS_REGION is unset.
# Keep both on the same region, and make it a region where every Bedrock model
# you need is enabled.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
