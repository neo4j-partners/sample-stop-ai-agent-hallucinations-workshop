# Environment variables for the workshop labs.
#
# Copy this file to `.env` (in the repo root, or in a specific lab folder
# such as 01-graph-build/) and fill in real values. A lab-local `.env` takes
# precedence over the root one. The `.env` file is gitignored and must never
# be committed.
#
# NOTE ON THE USERNAME VARIABLE: every lab in THIS repository reads
# NEO4J_USERNAME. The Workshop Studio CloudFormation environment writes a
# /workshop/.env that uses NEO4J_USER instead. If you are running inside the
# hosted workshop and a lab cannot authenticate, confirm which name is set.

# --- Neo4j (every lab) ---
# Neo4j Aura is the supported path: paste the neo4j+s:// URI from your AuraDB
# instance. A local Docker instance would be bolt://localhost:7687 instead.
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- Lab 5 AgentCore deploy (written by setup/provision_agentcore.py) ---
# You do NOT set these by hand. The provisioning script writes them into .env
# after it creates the infrastructure, and the deploy notebook then reads them.
# The deployed Runtime reads Neo4j from the NEO4J_* values above; there is no
# separate read secret.
# AGENTCORE_GATEWAY_URL=<gateway-mcp-url>
# AGENTCORE_RUNTIME_ROLE_ARN=<runtime-execution-role-arn>
# NEO4J_COMMAND_SECRET_ID=<reservation-command-secret-id>
# AGENT_RUNTIME_ARN=<deployed-runtime-arn>

# --- AWS / Amazon Bedrock (all labs) ---
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Workshop Studio deployment values (auto-populated by CloudFormation) ---
# You do NOT set these when running self-paced. They are listed here to match
# the hosted workshop environment.
# NEO4J_HOST=<neo4j-nlb-endpoint>
# NEO4J_SECRET_ARN=<secrets-manager-arn>
# SECURITY_GROUP_ID=<sg-id>
# SUBNET_IDS=<subnet-a>,<subnet-b>
